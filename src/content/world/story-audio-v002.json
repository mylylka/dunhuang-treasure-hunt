      "cues": [
        {
          "start": 0,
          "end": 2.5526,
          "text": "国王和王后在负心人的带领下，"
        },
        {
          "start": 2.5526,
          "end": 5.3991,
          "text": "同乘一辆马车前往围猎九色鹿，"
        },
        {
          "start": 5.3991,
          "end": 9.1096,
          "text": "此时九色鹿正在山中入睡，一无所知。"
