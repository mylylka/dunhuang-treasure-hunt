      "cues": [
        {
          "start": 0,
          "end": 3.1025,
          "text": "后来，这个国家的王后梦见九色鹿，"
        },
        {
          "start": 3.1025,
          "end": 7.005,
          "text": "她要求国王捕捉九色鹿，要用鹿皮做衣服。"
        },
        {
          "start": 7.005,
          "end": 11.4296,
          "text": "国王布告悬赏，溺水人见利忘义，到宫廷告密。"
