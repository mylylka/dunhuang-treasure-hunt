{
  "opening": {
    "path": "flying-history/v001/audio/opening.mp3",
    "duration": 22.221,
    "cues": [
      {
        "start": 0,
        "end": 2.604,
        "text": "你好，我是敦煌壁画中的飞天。"
      },
      {
        "start": 2.604,
        "end": 13.938,
        "text": "你发现了吗？我没有翅膀，却能自在地飞翔。画师用舒展的身姿、飘动的衣裙和长长的飘带，让我仿佛真的飞了起来。"
      },
      {
        "start": 13.938,
        "end": 22.221,
        "text": "一千多年来，随着不同文明在敦煌交流融合，我的模样也不断改变。想看看这些变化吗？"
      }
    ]
  },
  "flying": [
    {
      "path": "flying-history/v001/audio/flying-01.mp3",
      "duration": 21.977,
      "cues": [
        {
          "start": 0,
          "end": 2.432,
          "text": "敦煌地处丝绸之路要道"
        },
        {
          "start": 2.432,
          "end": 6.565,
          "text": "佛教艺术经西域传入 也带来了受到印度"
        },
        {
          "start": 6.565,
          "end": 10.132,
          "text": "中亚及犍陀罗艺术影响的飞天形象"
        },
        {
          "start": 10.132,
          "end": 13.565,
          "text": "莫高窟第275窟北壁的飞天"
        },
        {
          "start": 13.565,
          "end": 18.999,
          "text": "头戴光环 身形健壮 飘带宽短 身体呈“V”字形"
        },
        {
          "start": 18.999,
          "end": 21.965,
          "text": "保留了鲜明的早期西域艺术风格"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-02.mp3",
      "duration": 25.966,
      "cues": [
        {
          "start": 0,
          "end": 4.039,
          "text": "西魏时期 中原文化进一步影响敦煌"
        },
        {
          "start": 4.039,
          "end": 8.339,
          "text": "飞天开始呈现中原与西域艺术并存的特点"
        },
        {
          "start": 8.339,
          "end": 10.539,
          "text": "第249窟北壁中"
        },
        {
          "start": 10.539,
          "end": 14.806,
          "text": "同时出现了中原式和西域式的两种飞天"
        },
        {
          "start": 14.806,
          "end": 19.339,
          "text": "中原式飞天面容清秀 身穿红色汉服衣裙；"
        },
        {
          "start": 19.339,
          "end": 23.039,
          "text": "西域式飞天则上身裸露 身着短裙"
        },
        {
          "start": 23.039,
          "end": 25.939,
          "text": "展现了中西文化融合的过程"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-03.mp3",
      "duration": 26.2,
      "cues": [
        {
          "start": 0,
          "end": 2.777,
          "text": "北周鲜卑族统治者推崇佛教"
        },
        {
          "start": 2.777,
          "end": 7.81,
          "text": "且通好西域 因而莫高窟再度出现了西域式飞天"
        },
        {
          "start": 7.81,
          "end": 11.743,
          "text": "最突出的是面部和躯体采用凹凸晕染法"
        },
        {
          "start": 11.743,
          "end": 14.31,
          "text": "现因变色 出现了五白："
        },
        {
          "start": 14.31,
          "end": 17.877,
          "text": "白眉棱 白眼眶 白鼻梁 白嘴唇 白下巴"
        },
        {
          "start": 17.877,
          "end": 23.21,
          "text": "飞行姿态成敞口“U”字形 身躯短壮 动态朴拙"
        },
        {
          "start": 23.21,
          "end": 26.2,
          "text": "代表作品为第428窟飞天"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-04.mp3",
      "duration": 22.716,
      "cues": [
        {
          "start": 0,
          "end": 3.164,
          "text": "隋朝结束了南北长期分裂的局面"
        },
        {
          "start": 3.164,
          "end": 5.464,
          "text": "佛教艺术继续发展"
        },
        {
          "start": 5.464,
          "end": 9.997,
          "text": "敦煌飞天的数量 造型和飞行姿态更加丰富"
        },
        {
          "start": 9.997,
          "end": 14.231,
          "text": "人物逐渐修长柔美 女性化特征更加鲜明"
        },
        {
          "start": 14.231,
          "end": 18.497,
          "text": "隋代大量使用铅粉 导致人物皮肤氧化变黑"
        },
        {
          "start": 18.497,
          "end": 22.697,
          "text": "形成黑飞天特征 如第206窟飞天"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-05.mp3",
      "duration": 29.813,
      "cues": [
        {
          "start": 0,
          "end": 4.167,
          "text": "唐朝前期经济繁荣 丝绸之路交流活跃"
        },
        {
          "start": 4.167,
          "end": 7.667,
          "text": "开放的时代风貌也反映在飞天艺术中"
        },
        {
          "start": 7.667,
          "end": 11.834,
          "text": "这时期的敦煌飞天已少有印度 西域飞天的风貌"
        },
        {
          "start": 11.834,
          "end": 14.1,
          "text": "是完全中国化的飞天了"
        },
        {
          "start": 14.1,
          "end": 19.067,
          "text": "飞天身姿舒展 衣饰华丽 长长的飘带自由回旋"
        },
        {
          "start": 19.067,
          "end": 21.167,
          "text": "充满轻盈奔放的动感"
        },
        {
          "start": 21.167,
          "end": 25.034,
          "text": "代表作品有初唐第321窟双飞天"
        },
        {
          "start": 25.034,
          "end": 29.8,
          "text": "盛唐第320窟四飞天和第172窟飞天"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-06.mp3",
      "duration": 30.373,
      "cues": [
        {
          "start": 0,
          "end": 3.398,
          "text": "安史之乱后 唐朝政局发生变化"
        },
        {
          "start": 3.398,
          "end": 8.532,
          "text": "敦煌一度处于吐蕃统治之下 但石窟艺术仍在延续"
        },
        {
          "start": 8.532,
          "end": 11.732,
          "text": "这一时期飞天也渐渐发生了变化"
        },
        {
          "start": 11.732,
          "end": 14.998,
          "text": "人体由丰满娇美变为清瘦朴实；"
        },
        {
          "start": 14.998,
          "end": 18.398,
          "text": "衣饰上由艳丽丰厚转为淡雅轻薄；"
        },
        {
          "start": 18.398,
          "end": 22.232,
          "text": "神态上已由激奋欢乐变为平静忧思"
        },
        {
          "start": 22.232,
          "end": 26.765,
          "text": "建于吐蕃统治时期的第158窟《涅槃经变》"
        },
        {
          "start": 26.765,
          "end": 30.365,
          "text": "体现了中唐佛教艺术的庄重气质"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-07.mp3",
      "duration": 21.821,
      "cues": [
        {
          "start": 0,
          "end": 1.194,
          "text": "五代至宋初"
        },
        {
          "start": 1.194,
          "end": 4.894,
          "text": "敦煌主要由归义军曹氏地方政权治理"
        },
        {
          "start": 4.894,
          "end": 7.861,
          "text": "这一时期的飞天继承唐代余风"
        },
        {
          "start": 7.861,
          "end": 10.027,
          "text": "但无创新 不复生气"
        },
        {
          "start": 10.027,
          "end": 13.727,
          "text": "完全失去了唐代飞天生气欢快的基调"
        },
        {
          "start": 13.727,
          "end": 18.527,
          "text": "但也偶有佳作 代表作品有五代第61窟的散花"
        },
        {
          "start": 18.527,
          "end": 21.794,
          "text": "飞天和宋代第76窟的双飞天"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-08.mp3",
      "duration": 34.208,
      "cues": [
        {
          "start": 0,
          "end": 1.062,
          "text": "唐宋之后"
        },
        {
          "start": 1.062,
          "end": 5.196,
          "text": "敦煌经历了党项族建立的西夏政权统治"
        },
        {
          "start": 5.196,
          "end": 9.496,
          "text": "回鹘文化也在不同历史阶段留下了重要印记"
        },
        {
          "start": 9.496,
          "end": 12.596,
          "text": "不同族群的信仰 审美和艺术传统"
        },
        {
          "start": 12.596,
          "end": 14.962,
          "text": "继续丰富着敦煌壁画"
        },
        {
          "start": 14.962,
          "end": 19.229,
          "text": "此时的飞天出现了兼具少数民族风格的形象"
        },
        {
          "start": 19.229,
          "end": 24.562,
          "text": "脸型长圆 两腮外鼓 深目尖鼻 身体健壮"
        },
        {
          "start": 24.562,
          "end": 28.229,
          "text": "身穿皮衣 多饰珠环 世俗性很强"
        },
        {
          "start": 28.229,
          "end": 34.196,
          "text": "例如西夏第327窟 回鹘重绘的第97窟的飞天"
        }
      ]
    },
    {
      "path": "flying-history/v001/audio/flying-09.mp3",
      "duration": 22.321,
      "cues": [
        {
          "start": 0,
          "end": 2.154,
          "text": "元代蒙古族统治敦煌"
        },
        {
          "start": 2.154,
          "end": 7.421,
          "text": "石窟营建规模较前代缩小 但绘画技艺仍有所发展"
        },
        {
          "start": 7.421,
          "end": 11.554,
          "text": "第3窟《千手千眼观音经变》中的飞天"
        },
        {
          "start": 11.554,
          "end": 14.054,
          "text": "衣带较短 乘云飞行"
        },
        {
          "start": 14.054,
          "end": 17.088,
          "text": "形象带有中国传统仙童的韵味"
        },
        {
          "start": 17.088,
          "end": 19.188,
          "text": "壁画精细流畅的线描"
        },
        {
          "start": 19.188,
          "end": 22.321,
          "text": "也展现了元代绘画的艺术特色"
        }
      ]
    }
  ],
