  "novice-precepts": {
    "introduction": {
      "path": "mogao-mural-audio/v001/novice-precepts/introduction.mp3",
      "duration": 9.96,
      "text": "此画现于257窟南壁，依据了《贤愚经》所绘的沙弥守戒故事，是佛教戒律画代表作之一。",
      "cues": [
        {
          "start": 0,
          "end": 2.94,
          "text": "此画现于257窟南壁，"
        },
        {
          "start": 2.94,
          "end": 7.073,
          "text": "依据了《贤愚经》所绘的沙弥守戒故事，"
        },
        {
          "start": 7.073,
          "end": 9.96,
          "text": "是佛教戒律画代表作之一。"
        }
      ]
    },
    "ordination": {
      "path": "mogao-mural-audio/v001/novice-precepts/ordination.mp3",
      "duration": 31.41,
      "text": "故事发生在古代印度。当时，有一位德高望重的僧人，远近闻名。一位长者把自己的儿子送到他身边学习修行。少年剃去头发，出家成为了一名沙弥。这位僧人平时接受一户信佛人家的供养。一天，僧人便派小沙弥去取食物，临行前还特意叮嘱他，要谨记出家人的戒律。没想到，这次普通的取食，竟然发生了意外。",
      "cues": [
        {
          "start": 0,
          "end": 2.303,
          "text": "故事发生在古代印度。"
        },
        {
          "start": 2.303,
          "end": 6.436,
          "text": "当时，有一位德高望重的僧人，远近闻名。"
        },
