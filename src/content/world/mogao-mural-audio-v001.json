    "ending": {
      "path": "mogao-mural-audio/v001/bandits/ending.mp3",
      "duration": 16.98,
      "text": "故事以自然景致为画面的区划，激烈的战争和残酷的刑罚，与双眼复明后出家隐居山林参禅入定的场面形成了鲜明的对照，是西魏期故事画的经典之作。",
      "cues": [
        {
          "start": 0,
          "end": 16.98,
          "text": "故事以自然景致为画面的区划，激烈的战争和残酷的刑罚，与双眼复明后出家隐居山林参禅入定的场面形成了鲜明的对照，是西魏期故事画的经典之作。"
        }
      ]
    }
  },
