            740.26171875,
            355.36070381231673
          ],
          "originalRegion": [
            0,
            158,
            698,
            493
          ]
        }
      ]
    },
    {
      "id": "novice-and-girl",
      "title": "沙弥与少女",
      "text": "这户人家的少女独自在家，见到小沙弥十分高兴。她希望小沙弥留下来与自己结为夫妻，可小沙弥坚决拒绝了。少女执意挽留，小沙弥为了坚守戒律，最终做出了结束自己生命的悲惨选择。少女发现后，伤心不已。",
      "audio": "novice-and-girl.mp3",
      "images": [
        {
