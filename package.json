{
  "name": "dunhuang-treasure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "play": "node scripts/serve-preview.mjs --port=5173 --no-open",
    "playtest:build": "node scripts/build-world-playtests-v001.mjs",
    "playtest:serve": "node scripts/serve-world-playtests-v001.mjs",
    "playtest:prune": "node scripts/prune-playtest-artifacts.mjs",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=work/browsers playwright test",
    "test:browsers": "PLAYWRIGHT_BROWSERS_PATH=work/browsers playwright install chromium webkit",
    "test:production": "node scripts/verify-production.mjs",
    "build": "npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
